import java.io.*;
import java.util.*;
import java.text.*;
import java.math.*;
import java.util.regex.*;

public class Solution {


    public static int insertionSort(int n,int array[]) {
      int i, j, newValue,shift=0;
      for (i = 1; i < n; i++) {
            newValue = array[i];
            j = i;
            while (j > 0 && array[j - 1] > newValue) {
                  array[j] = array[j - 1];
                  j--;
                  shift++;
            }
            array[j] = newValue;
      }
    return shift;
        }
   
 public static void main(String[] args) {
        Scanner in = new Scanner(System.in);
        int n;
        n = in.nextInt();
        int[] array= new int[n];
        int i = 0;
        while(in.hasNextInt()){
        array[i] = in.nextInt();
        i++;
        if(i == n){
            break;
        }
    }   
        int shift;
        shift=insertionSort(n,array);
        System.out.println(shift);
}
}
